---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Arihant Jha · Lab Notebook',
  description = 'Data engineer who builds and evaluates LLM systems. A running log of pipelines, evals and guardrails.',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="masthead">
      <div class="page">
        <a href="/" class="mark">
          <span class="mark-name">Arihant Jha</span>
          <span class="mark-sub">lab notebook</span>
        </a>
        <nav>
          <a href="/#log">Log</a>
          <a href="https://github.com/arihaaant">GitHub</a>
          <a href="https://linkedin.com/in/arihant-jha">LinkedIn</a>
          <a href="mailto:arihant.jha1999@outlook.com">Email</a>
        </nav>
      </div>
    </header>
    <main class="page">
      <slot />
    </main>
    <footer class="page colophon">
      <span>Set in Fraunces, Source Serif &amp; JetBrains Mono. Built with Astro.</span>
      <span>Madison, WI</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f4f1ea;
    --paper-raised: #fbf9f4;
    --grid: rgba(60, 50, 30, 0.05);
    --ink: #1d1b17;
    --ink-soft: #5a554b;
    --ink-faint: #8f887a;
    --rule: #d9d3c5;
    --accent: #c2410c;
    --shipped: #3f7d4e;
    --running: #c98a0c;
    --planned: #8f887a;
    --archived: #a39e93;
    --highlight: #f6e3b4;

    --display: 'Fraunces', Georgia, serif;
    --serif: 'Source Serif 4', Georgia, serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #16171a;
      --paper-raised: #1d1e22;
      --grid: rgba(255, 255, 255, 0.03);
      --ink: #ebe6db;
      --ink-soft: #b3ac9e;
      --ink-faint: #7d776c;
      --rule: #34353a;
      --accent: #f28a4b;
      --shipped: #6fbf83;
      --running: #e8b44a;
      --planned: #7d776c;
      --archived: #5d5a54;
      --highlight: #3b3220;
    }
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-padding-top: 80px; }
  body {
    margin: 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.6;
    background-color: var(--paper);
    /* faint engineering-paper grid */
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  ::selection { background: var(--highlight); }
  a { color: inherit; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  a:hover { color: var(--accent); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .page { max-width: 880px; margin: 0 auto; padding: 0 20px; }
  .mono { font-family: var(--mono); font-size: 13px; letter-spacing: 0.02em; }

  .masthead { border-bottom: 1px solid var(--rule); background: color-mix(in srgb, var(--paper) 85%, transparent); backdrop-filter: blur(6px); position: sticky; top: 0; z-index: 10; }
  .masthead .page { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 60px; }
  .mark { text-decoration: none; display: flex; align-items: baseline; gap: 10px; }
  .mark-name { font-family: var(--display); font-weight: 700; font-size: 20px; }
  .mark-sub { font-family: var(--mono); font-size: 12px; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.08em; }
  nav { display: flex; gap: 18px; font-family: var(--mono); font-size: 13px; }
  nav a { text-decoration: none; color: var(--ink-soft); }
  nav a:hover { color: var(--accent); }
  @media (max-width: 560px) {
    .mark-sub { display: none; }
    nav { gap: 12px; font-size: 12px; }
  }

  .colophon {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px;
    margin-top: 120px; padding-top: 20px; padding-bottom: 48px;
    border-top: 1px solid var(--rule);
    font-family: var(--mono); font-size: 12px; color: var(--ink-faint);
  }

  /* status glyphs, shared by the log and entry pages */
  .glyph { width: 12px; height: 12px; border-radius: 50%; display: inline-block; flex: none; border: 2px solid currentColor; }
  .glyph.shipped { color: var(--shipped); background: currentColor; }
  .glyph.running { color: var(--running); background: linear-gradient(90deg, currentColor 50%, transparent 50%); }
  .glyph.planned { color: var(--planned); background: transparent; }
  .glyph.archived { color: var(--archived); background: transparent; border-style: dashed; }
  .status-shipped { color: var(--shipped); }
  .status-running { color: var(--running); }
  .status-planned { color: var(--planned); }
  .status-archived { color: var(--archived); }
</style>
